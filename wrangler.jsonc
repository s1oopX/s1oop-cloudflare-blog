{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "s1oop-cloudflare-blog-api",
  "main": "workers/api.js",
  "compatibility_date": "2026-05-02",
  "vars": {
    "COMMENTS_ENABLED": "false"
  },

  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "s1oop-blog-content",
      "database_id": "9f4cebc7-ea37-4c15-bdd7-e734cdd39d65"
    }
  ],

  // Runtime post images:
  // Create this R2 bucket, then bind it to Pages Functions as BLOG_IMAGES.
  //
  // "r2_buckets": [
  //   {
  //     "binding": "BLOG_IMAGES",
  //     "bucket_name": "s1oop-blog-images"
  //   }
  // ],

  // Optional visit counters:
  // Create a KV namespace, then uncomment and replace the ids.
  //
  // "kv_namespaces": [
  //   {
  //     "binding": "BLOG_KV",
  //     "id": "<production-kv-namespace-id>",
  //     "preview_id": "<preview-kv-namespace-id>"
  //   }
  // ]
}
