---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { collectTags, visiblePosts } from '../../lib/posts';

const posts = visiblePosts(await getCollection('posts'));
const tags = collectTags(posts);
const tagStats = tags.map((tag) => ({
  tag,
  count: posts.filter((post) => post.data.tags.includes(tag)).length,
}));
const maxTagCount = Math.max(1, ...tagStats.map((item) => item.count));
---

<BaseLayout title="主题索引 | s1oop's Blog">
  <section class="ui-page archive-page">
    <PageHeader
      eyebrow="taxonomy"
      title="主题索引"
      description="按主题进入相近文章。这里适合回找某一类内容，而不是从时间线重新翻起。"
    />

    <div class="ui-grid ui-page-body">
      <div class="tag-index-grid ui-stagger">
        {tagStats.map(({ tag, count }) => (
          <a
            href={`/tags/${tag.toLowerCase()}`}
            class="tag-index-card ui-panel ui-panel-link no-underline"
            style={`--tag-share: ${(count / maxTagCount) * 100}%`}
          >
            <span class="tag-index-name">#{tag}</span>
            <span class="tag-index-count">{count} 篇</span>
            <span class="tag-index-meter" aria-hidden="true"></span>
          </a>
        ))}
        {tags.length === 0 && (
          <div class="ui-panel p-5 text-sm text-zinc-400">暂无标签。</div>
        )}
      </div>

      <aside class="ui-sidebar ui-stagger">
        <section class="ui-panel">
          <div class="ui-panel-header">
            <h2 class="text-sm font-medium text-white">主题概览</h2>
          </div>
          <div class="ui-panel-body grid gap-4">
            <div class="ui-stat-row">
              <span class="ui-stat-label">主题</span>
              <span class="ui-stat-value">{tags.length}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">文章</span>
              <span class="ui-stat-value">{posts.length}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">类型</span>
              <span class="ui-stat-value">主题</span>
            </div>
          </div>
        </section>

        <section class="ui-panel">
          <div class="ui-panel-header">
            <h2 class="text-sm font-medium text-white">阅读说明</h2>
          </div>
          <div class="ui-panel-body">
            <p class="text-sm leading-6 text-zinc-400">主题用于聚合同一方向的文章，便于连续阅读和回看。</p>
          </div>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
