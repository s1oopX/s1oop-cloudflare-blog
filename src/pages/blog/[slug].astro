---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection, render } from 'astro:content';
import { collections, postsForCollection } from '../../lib/collections';
import { formatPostDate, postHref, postReadingStats, postSlug, relatedPostsFor, visiblePosts } from '../../lib/posts';
import '../../styles/reading.css';
import '../../styles/article-sidebar.css';

export async function getStaticPaths() {
  const posts = visiblePosts(await getCollection('posts'));
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = visiblePosts(await getCollection('posts'));
const relatedPosts = relatedPostsFor(post, posts);
const readingStats = postReadingStats(post);
const currentSlug = postSlug(post);
const currentTags = new Set(post.data.tags.map((tag) => tag.toLowerCase()));
const collectionSequence = collections
  .map((collection) => postsForCollection(collection, posts))
  .find((items) => {
    const currentIndex = items.findIndex((item) => item.id === post.id);
    return currentIndex >= 0 && items.length > 1;
  });
const tagSequence = posts.filter((item) => (
  item.id === post.id || item.data.tags.some((tag) => currentTags.has(tag.toLowerCase()))
));
const neighborsFor = (sequence: typeof posts) => {
  const currentIndex = sequence.findIndex((item) => postSlug(item) === currentSlug);
  return {
    previous: currentIndex > 0 ? sequence[currentIndex - 1] : null,
    next: currentIndex >= 0 && currentIndex < sequence.length - 1 ? sequence[currentIndex + 1] : null,
  };
};
const collectionNeighbors = collectionSequence ? neighborsFor(collectionSequence) : { previous: null, next: null };
const tagNeighbors = tagSequence.length > 1 ? neighborsFor(tagSequence) : { previous: null, next: null };
const timeNeighbors = neighborsFor(posts);
const previousPost = collectionNeighbors.previous ?? tagNeighbors.previous ?? timeNeighbors.previous;
const nextPost = collectionNeighbors.next ?? tagNeighbors.next ?? timeNeighbors.next;
---

<BaseLayout title={`${post.data.title} | s1oop's Blog`}>
  <article class="ui-page reading-page">
    <PageHeader
      eyebrow={formatPostDate(post.data.date)}
      title={post.data.title}
      description={post.data.excerpt}
    >
      <Fragment slot="actions">
        <a href="/blog" class="ui-button">全部内容</a>
      </Fragment>
    </PageHeader>

    <div class="ui-grid ui-page-body">
      <div class="ui-stack">
        <div class="post-content reading-surface ui-panel p-6 sm:p-8">
          <Content />
        </div>

        {(previousPost || nextPost) && (
          <nav class="reading-nav" aria-label="文章导航">
            {previousPost && (
              <a href={postHref(previousPost)} class="reading-nav-link reading-nav-prev">
                <span class="reading-nav-label">上一篇</span>
                <span class="reading-nav-title">{previousPost.data.title}</span>
              </a>
            )}
            {nextPost && (
              <a href={postHref(nextPost)} class="reading-nav-link reading-nav-next">
                <span class="reading-nav-label">下一篇</span>
                <span class="reading-nav-title">{nextPost.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <Comments slug={postSlug(post)} />
      </div>

      <aside class="ui-sidebar reading-sidebar ui-stagger">
        <section class="ui-panel">
          <div class="ui-panel-header">
            <h2 class="ui-panel-title">文章信息</h2>
          </div>
          <div class="ui-panel-body grid gap-4">
            <div class="ui-stat-row">
              <span class="ui-stat-label">日期</span>
              <span class="ui-stat-value">{formatPostDate(post.data.date)}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">类型</span>
              <span class="ui-stat-value">文章</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">字数</span>
              <span class="ui-stat-value">约 {readingStats.wordCount} 字</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">阅读</span>
              <span class="ui-stat-value">{readingStats.readingMinutes} 分钟</span>
            </div>
            <div class="grid gap-2 border-t border-white/10 pt-4">
              <span class="ui-stat-label">标签</span>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <a href={`/search?q=${encodeURIComponent(tag)}`} class="ui-badge no-underline hover:text-white">
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="ui-panel">
          <div class="ui-panel-header">
            <h2 class="ui-panel-title">继续阅读</h2>
          </div>
          <div class="ui-panel-body article-related-list">
            {relatedPosts.map((item) => (
              <a href={postHref(item)} class="article-related-item no-underline">
                <span class="article-related-date">{formatPostDate(item.data.date)}</span>
                <span class="article-related-title">{item.data.title}</span>
              </a>
            ))}
            {relatedPosts.length === 0 && (
              <p class="text-sm text-zinc-400">暂无其他文章。</p>
            )}
          </div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
