---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveSidebar from '../../components/ArchiveSidebar.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pagination from '../../components/Pagination.astro';
import { collectionHref, collections } from '../../lib/collections';
import { POSTS_PER_PAGE } from '../../lib/posts';

const currentPage = 1;
const totalPages = 1;
const archivePaths = collections.map((collection) => ({
  slug: collection.slug,
  href: collectionHref(collection),
  title: collection.title,
  count: 0,
  runtimeTags: collection.runtimeTags,
}));
const initialPostData: unknown[] = [];
---

<BaseLayout title="全部内容 | s1oop's Blog">
  <section class="ui-page archive-page">
    <PageHeader
      eyebrow="full archive"
      title="全部内容"
      description="所有已经整理好的文章都保留在这里。这里是默认入口，适合慢慢回看。"
    />

    <div class="ui-grid ui-page-body">
      <div
        class="ui-stack archive-post-list"
        data-post-list
        data-page-size={POSTS_PER_PAGE}
        data-initial-posts={JSON.stringify(initialPostData)}
        data-archive-paths={JSON.stringify(archivePaths)}
      >
        <!-- Zero-CLS Skeleton Stream -->
        <div class="skeleton-stream" aria-hidden="true">
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-24"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-3/4"></div>
            <div class="skeleton-line mt-2 h-4 w-full"></div>
          </div>
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-24"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-2/3"></div>
            <div class="skeleton-line mt-2 h-4 w-5/6"></div>
          </div>
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-24"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-1/2"></div>
            <div class="skeleton-line mt-2 h-4 w-4/5"></div>
          </div>
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-24"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-3/5"></div>
            <div class="skeleton-line mt-2 h-4 w-3/4"></div>
          </div>
        </div>

        <div data-post-pagination>
          <Pagination currentPage={currentPage} totalPages={totalPages} baseHref="/blog" queryParam="page" />
        </div>
      </div>

      <ArchiveSidebar
        postCount={0}
        tagCount={0}
        latestLabel="-"
      />
    </div>
  </section>

  <script type="module" src="/scripts/blog-index.js"></script>
</BaseLayout>
