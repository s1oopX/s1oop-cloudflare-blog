---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { POSTS_PER_PAGE, collectTags, formatPostDate, pageItems, postExcerpt, postHref, postImage, postsWithinRecentDays, visiblePosts } from '../../lib/posts';

const posts = visiblePosts(await getCollection('posts'));
const recentPosts = postsWithinRecentDays(posts, 1);
const tags = collectTags(recentPosts);
const latestPost = recentPosts[0];
const latestPosts = pageItems(recentPosts, 1, POSTS_PER_PAGE);
---

<BaseLayout title="最近 | s1oop's Blog">
  <section class="ui-page archive-page">
    <PageHeader
      eyebrow="latest entries"
      title="最近"
      description="最近 1 天内发布的文章会先放在这里。"
    >
      <Fragment slot="actions">
        <a href="/blog/archive" class="ui-button">查看全部</a>
      </Fragment>
    </PageHeader>

    <div class="ui-grid ui-page-body">
      <div class="ui-stack">
        <section class="ui-stack">
          <div class="ui-stagger grid gap-5">
            {latestPosts.map((post) => (
              <PostCard
                title={post.data.title}
                excerpt={postExcerpt(post)}
                href={postHref(post)}
                date={formatPostDate(post.data.date)}
                tags={post.data.tags}
                image={postImage(post)}
              />
            ))}
          </div>
        </section>

        {recentPosts.length === 0 && (
          <div class="ui-panel p-6">
            <h2 class="text-lg font-semibold text-white">最近 1 天没有新文章</h2>
            <p class="mt-2 text-sm text-zinc-400">可以前往全部文章回看已经整理好的内容。</p>
          </div>
        )}
      </div>

      <aside class="ui-sidebar ui-stagger">
        <section class="ui-panel">
          <div class="ui-panel-header">
            <h2 class="text-sm font-medium text-white">阅读概览</h2>
          </div>
          <div class="ui-panel-body grid gap-4">
            <div class="ui-stat-row">
              <span class="ui-stat-label">文章</span>
              <span class="ui-stat-value">{recentPosts.length}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">主题</span>
              <span class="ui-stat-value">{tags.length}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">最新</span>
              <span class="ui-stat-value">{latestPost ? formatPostDate(latestPost.data.date) : '-'}</span>
            </div>
          </div>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
