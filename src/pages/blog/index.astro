---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveSidebar from '../../components/ArchiveSidebar.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import { collectionHref, collections, postsForCollection } from '../../lib/collections';
import { POSTS_PER_PAGE, collectTags, formatPostDate, pageCount, pageItems, postExcerpt, postHref, postImage, visiblePosts } from '../../lib/posts';

const posts = visiblePosts(await getCollection('posts'));
const tags = collectTags(posts);
const latestPost = posts[0];
const currentPage = 1;
const totalPages = pageCount(posts, POSTS_PER_PAGE);
const paginatedPosts = pageItems(posts, currentPage, POSTS_PER_PAGE);
const archivePaths = collections.map((collection) => ({
  slug: collection.slug,
  href: collectionHref(collection),
  title: collection.title,
  count: postsForCollection(collection, posts).length,
  runtimeTags: collection.runtimeTags,
}));
const staticPostData = posts.map((post) => ({
  title: post.data.title,
  excerpt: postExcerpt(post),
  href: postHref(post),
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  image: postImage(post),
  runtime: false,
}));
---

<BaseLayout title="全部内容 | s1oop's Blog">
  <section class="ui-page archive-page">
    <PageHeader
      eyebrow="full archive"
      title="全部内容"
      description="所有已经整理好的文章都保留在这里。这里是默认入口，适合慢慢回看。"
    />

    <div class="ui-grid ui-page-body">
      <div
        class="ui-stack ui-stagger archive-post-list"
        data-post-list
        data-page-size={POSTS_PER_PAGE}
        data-static-posts={JSON.stringify(staticPostData)}
        data-archive-paths={JSON.stringify(archivePaths)}
      >
        {paginatedPosts.map((post) => (
          <PostCard
            title={post.data.title}
            excerpt={postExcerpt(post)}
            href={postHref(post)}
            date={formatPostDate(post.data.date)}
            tags={post.data.tags}
            image={postImage(post)}
          />
        ))}
        <div data-post-pagination>
          <Pagination currentPage={currentPage} totalPages={totalPages} baseHref="/blog/page" firstHref="/blog" />
        </div>
      </div>

      <ArchiveSidebar
        postCount={posts.length}
        tagCount={tags.length}
        latestLabel={latestPost ? formatPostDate(latestPost.data.date) : '-'}
        paths={archivePaths}
      />
    </div>
  </section>

  <script type="module" src="/scripts/blog-index.js"></script>
</BaseLayout>
