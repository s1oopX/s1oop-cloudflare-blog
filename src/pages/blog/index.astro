---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import SiteStatusPanel from '../../components/SiteStatusPanel.astro';
import { collectionHref, collections, postsForCollection } from '../../lib/collections';
import { POSTS_PER_PAGE, collectTags, formatPostDate, pageCount, pageItems, postExcerpt, postHref, postImage, visiblePosts } from '../../lib/posts';

const posts = visiblePosts(await getCollection('posts'));
const tags = collectTags(posts);
const latestPost = posts[0];
const currentPage = 1;
const totalPages = pageCount(posts, POSTS_PER_PAGE);
const paginatedPosts = pageItems(posts, currentPage, POSTS_PER_PAGE);
const archivePaths = collections.map((collection) => ({
  href: collectionHref(collection),
  title: collection.title,
  count: postsForCollection(collection, posts).length,
  runtimeTags: collection.runtimeTags,
}));
const staticPostData = posts.map((post) => ({
  title: post.data.title,
  excerpt: postExcerpt(post),
  href: postHref(post),
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  image: postImage(post),
  runtime: false,
}));
---

<BaseLayout title="全部内容 | s1oop's Blog">
  <section class="ui-page archive-page">
    <PageHeader
      eyebrow="full archive"
      title="全部内容"
      description="所有已经整理好的文章都保留在这里。这里是默认入口，适合慢慢回看。"
    />

    <div class="ui-grid ui-page-body">
      <div
        class="ui-stack ui-stagger archive-post-list"
        data-post-list
        data-page-size={POSTS_PER_PAGE}
        data-static-posts={JSON.stringify(staticPostData)}
        data-archive-paths={JSON.stringify(archivePaths)}
      >
        {paginatedPosts.map((post, index) => (
          <>
            <PostCard
              title={post.data.title}
              excerpt={postExcerpt(post)}
              href={postHref(post)}
              date={formatPostDate(post.data.date)}
              tags={post.data.tags}
              image={postImage(post)}
            />
            {index === 3 && paginatedPosts.length > 4 && (
              <section class="archive-path-break ui-panel" aria-label="按专栏继续阅读" data-archive-path-break>
                <div>
                  <p class="ui-eyebrow">reading paths</p>
                  <h2>换一条路线继续读</h2>
                </div>
                <div class="archive-path-links">
                  {archivePaths.map((path) => (
                    <a href={path.href}>
                      <span>{path.count} 篇</span>
                      <strong>{path.title}</strong>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </>
        ))}
        <div data-post-pagination>
          <Pagination currentPage={currentPage} totalPages={totalPages} baseHref="/blog/page" firstHref="/blog" />
        </div>
      </div>

      <aside class="ui-sidebar ui-stagger">
        <SiteStatusPanel />

        <section class="ui-panel">
          <div class="ui-panel-header">
            <h2 class="ui-panel-title">阅读概览</h2>
          </div>
          <div class="ui-panel-body grid gap-4">
            <div class="ui-stat-row">
              <span class="ui-stat-label">文章</span>
              <span class="ui-stat-value" data-post-count>{posts.length}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">标签</span>
              <span class="ui-stat-value" data-tag-count>{tags.length}</span>
            </div>
            <div class="ui-stat-row">
              <span class="ui-stat-label">最新</span>
              <span class="ui-stat-value" data-latest-post>{latestPost ? formatPostDate(latestPost.data.date) : '-'}</span>
            </div>
          </div>
        </section>
      </aside>
    </div>
  </section>

  <script type="module" src="/scripts/blog-index.js"></script>
</BaseLayout>
