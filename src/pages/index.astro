---
import BaseLayout from '../layouts/BaseLayout.astro';
import { collections, collectionHref } from '../lib/collections';
---

<BaseLayout
  title="s1oop的博客"
  description="s1oop的个人博客：关于设计、写作、工程实现与长期观察。安静阅读，定期整理。"
  hideChrome={false}
>
  <div class="page-shell py-8 sm:py-12">
    <!-- Hero Masthead Section -->
    <header class="border-b border-zinc-200 pb-10 sm:pb-14">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
        <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-full border border-zinc-300 bg-zinc-100 shadow-sm sm:h-24 sm:w-24">
          <img
            src="/images/avatar.jpg"
            alt="s1oop avatar"
            class="h-full w-full object-cover grayscale"
            width="96"
            height="96"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl" style="font-family: var(--font-display);">
              s1oop's Blog
            </h1>
            <span class="rounded-full border border-zinc-200 bg-white px-2.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-widest text-zinc-500 shadow-xs">
              quiet archive
            </span>
          </div>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg">
            收集设计、写作、工程实现与日常思考。不追赶热度，只保留值得长期回看的判断与经验整理。
          </p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <a href="/blog" class="ui-button ui-button-primary">
              全部文章
            </a>
            <a href="/collections" class="ui-button">
              精选专栏
            </a>
            <a href="/about" class="ui-button">
              关于我
            </a>
            <a href="/search" class="ui-button">
              搜索
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Curated Collections Section -->
    <section class="mt-10 sm:mt-14">
      <div class="flex items-baseline justify-between border-b border-zinc-200 pb-3">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 font-semibold">
          精选专栏 / Collections
        </h2>
        <a href="/collections" class="font-mono text-xs text-zinc-500 hover:text-black no-underline">
          查看专栏全部 -&gt;
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {collections.map((col) => (
          <a
            href={collectionHref(col)}
            class="group block rounded-lg border border-zinc-200 bg-white p-5 no-underline shadow-xs transition hover:-translate-y-0.5 hover:border-zinc-400 hover:shadow-md"
          >
            <span class="font-mono text-[0.68rem] uppercase tracking-widest text-zinc-400">
              {col.eyebrow}
            </span>
            <h3 class="mt-2 text-lg font-bold text-zinc-900 group-hover:text-black" style="font-family: var(--font-display);">
              {col.title}
            </h3>
            <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-zinc-500">
              {col.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Recent Writings Stream -->
    <section class="mt-12 sm:mt-16">
      <div class="flex items-baseline justify-between border-b border-zinc-200 pb-3">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 font-semibold">
          近期思考 / Recent Stream
        </h2>
        <a href="/blog" class="font-mono text-xs text-zinc-500 hover:text-black no-underline">
          完整博客归档 -&gt;
        </a>
      </div>

      <div class="mt-4" data-home-feed>
        <div class="py-12 text-center text-sm text-zinc-400">正在读取最新文章...</div>
      </div>

      <div class="mt-8 text-center sm:text-left">
        <a href="/blog" class="ui-button ui-button-primary px-6 py-2.5 text-sm">
          查看全部文章归档 -&gt;
        </a>
      </div>
    </section>
  </div>

  <script type="module" src="/scripts/home-feed.js"></script>
</BaseLayout>
