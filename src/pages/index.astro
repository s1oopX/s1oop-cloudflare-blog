---
import BaseLayout from '../layouts/BaseLayout.astro';
import { collections, collectionHref } from '../lib/collections';
---

<BaseLayout
  title="s1oop的博客"
  description="s1oop的个人博客：关于设计、写作、工程实现与长期观察。安静阅读，定期整理。"
  hideChrome={false}
>
  <div class="page-shell py-8 sm:py-12">
    <!-- Hero Masthead Section -->
    <header class="border-b border-zinc-200 pb-10 sm:pb-12">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
        <div class="relative h-32 w-32 shrink-0 overflow-hidden rounded-full border-2 border-zinc-200 bg-zinc-100 shadow-md sm:h-40 sm:w-40">
          <img
            src="/images/avatar.jpg?v=2026082902"
            alt="s1oop avatar"
            class="h-full w-full object-cover"
            width="160"
            height="160"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl" style="font-family: var(--font-display);">
              s1oop's Blog
            </h1>
            <span class="rounded-full border border-zinc-200 bg-white px-2.5 py-0.5 font-mono text-[0.7rem] uppercase tracking-widest text-zinc-500 shadow-sm">
              quiet archive
            </span>
          </div>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600 sm:text-lg">
            收集设计、写作、工程实现与日常思考。不追赶热度，只保留值得长期回看的判断与经验整理。
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-4 text-xs font-mono text-zinc-400">
            <span class="inline-flex items-center gap-1.5 text-zinc-600">
              <span class="h-1.5 w-1.5 rounded-full bg-zinc-950"></span> 持续整理中
            </span>
            <span>&middot;</span>
            <a href="/blog" class="text-zinc-600 hover:text-black no-underline transition font-semibold">
              全部归档 &rarr;
            </a>
            <span>&middot;</span>
            <a href="/collections" class="text-zinc-600 hover:text-black no-underline transition font-semibold">
              精选专栏 &rarr;
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Curated Collections Section -->
    <section class="mt-10 sm:mt-12">
      <div class="flex items-baseline justify-between border-b border-zinc-200 pb-3">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 font-semibold">
          精选专栏 / Collections
        </h2>
        <a href="/collections" class="font-mono text-xs text-zinc-500 hover:text-black no-underline">
          查看全部专栏 &rarr;
        </a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {collections.map((col) => (
          <a
            href={collectionHref(col)}
            class="group block rounded-lg border border-zinc-200 bg-white p-5 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-zinc-400 hover:shadow-md"
          >
            <span class="font-mono text-[0.68rem] uppercase tracking-widest text-zinc-400">
              {col.eyebrow}
            </span>
            <h3 class="mt-2 text-lg font-bold text-zinc-900 group-hover:text-black" style="font-family: var(--font-display);">
              {col.title}
            </h3>
            <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-zinc-500">
              {col.description}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Recent Writings Stream -->
    <section class="mt-12 sm:mt-14">
      <div class="flex items-baseline justify-between border-b border-zinc-200 pb-3">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 font-semibold">
          近期思考 / Recent Stream
        </h2>
        <a href="/blog" class="font-mono text-xs text-zinc-500 hover:text-black no-underline">
          完整文章归档 &rarr;
        </a>
      </div>

      <div class="mt-2" data-home-feed>
        <!-- Zero-CLS Skeleton placeholder -->
        <div class="skeleton-stream" aria-hidden="true">
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-20"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-3/4"></div>
            <div class="skeleton-line mt-2 h-4 w-full"></div>
          </div>
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-20"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-2/3"></div>
            <div class="skeleton-line mt-2 h-4 w-5/6"></div>
          </div>
          <div class="skeleton-item">
            <div class="flex justify-between">
              <div class="skeleton-line h-3 w-20"></div>
              <div class="skeleton-line h-4 w-12"></div>
            </div>
            <div class="skeleton-line mt-3 h-6 w-1/2"></div>
            <div class="skeleton-line mt-2 h-4 w-4/5"></div>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center sm:text-left">
        <a href="/blog" class="ui-button ui-button-primary px-6 py-2.5 text-sm">
          查看全部文章归档 &rarr;
        </a>
      </div>
    </section>
  </div>

  <script type="module" src="/scripts/home-feed.js"></script>
</BaseLayout>
