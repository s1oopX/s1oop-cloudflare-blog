<span
  id="visitor-badge"
  class="inline-flex rounded-full border border-line bg-white/70 px-3 py-1 font-mono text-xs text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900/70 dark:text-zinc-300"
>
  游客----
</span>

<script is:inline>
  const key = 's1oop:visitor-id';
  let visitorId = localStorage.getItem(key);

  if (!visitorId) {
    visitorId = `游客${Math.floor(1000 + Math.random() * 9000)}`;
    localStorage.setItem(key, visitorId);
  }

  const badge = document.getElementById('visitor-badge');
  if (badge) badge.textContent = visitorId;

  fetch('/api/stats/visit', {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ visitorId, path: location.pathname }),
  }).catch(() => {
    // 访问记录不可用时保持静默，不影响正常阅读。
  });
</script>
