---
interface ArchivePath {
  slug: string;
  href: string;
  title: string;
  count: number;
}

interface Props {
  postCount: number;
  tagCount: number;
  latestLabel: string;
  paths: ArchivePath[];
}

const { postCount, tagCount, latestLabel, paths } = Astro.props;
---

<aside class="ui-sidebar ui-stagger">
  <section class="ui-panel">
    <div class="ui-panel-header">
      <h2 class="ui-panel-title">阅读概览</h2>
    </div>
    <div class="ui-panel-body grid gap-4">
      <div class="ui-stat-row">
        <span class="ui-stat-label">文章</span>
        <span class="ui-stat-value" data-post-count>{postCount}</span>
      </div>
      <div class="ui-stat-row">
        <span class="ui-stat-label">标签</span>
        <span class="ui-stat-value" data-tag-count>{tagCount}</span>
      </div>
      <div class="ui-stat-row">
        <span class="ui-stat-label">最新</span>
        <span class="ui-stat-value" data-latest-post>{latestLabel}</span>
      </div>
    </div>
  </section>

  <section class="ui-panel" aria-label="内容路线">
    <div class="ui-panel-header">
      <h2 class="ui-panel-title">内容路线</h2>
    </div>
    <div class="ui-panel-body">
      <div class="sidebar-link-list">
        {paths.map((path) => (
          <a href={path.href} class="sidebar-link-item no-underline">
            <span class="sidebar-link-kicker" data-archive-path-count={path.slug}>{path.count} 篇</span>
            <span class="sidebar-link-title">{path.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</aside>
