---
interface Props {
  title: string;
  excerpt: string;
  href: string;
  date?: Date | string;
  tags?: string[];
  image?: {
    src: string;
    alt: string;
  } | null;
}

const { title, excerpt, href, date, tags = [], image = null } = Astro.props;
const displayDate = date instanceof Date
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(date)
  : date;
const dateTime = date instanceof Date
  ? date.toISOString().slice(0, 10)
  : date;
const visibleTags = tags.slice(0, 2);
const extraTagCount = Math.max(0, tags.length - visibleTags.length);
---

<article class="post-card">
  <a href={href} class="post-card-link">
    <div class="post-card-header">
      <time class="post-card-date" datetime={dateTime}>{displayDate}</time>
      <div class="post-card-meta">
        {visibleTags.map((tag) => (
          <span class="ui-badge">#{tag}</span>
        ))}
        {extraTagCount > 0 && (
          <span class="ui-badge">+{extraTagCount}</span>
        )}
      </div>
    </div>
    <h2 class="post-card-title">{title}</h2>
    <p class="post-card-excerpt">{excerpt}</p>
    {image?.src && (
      <div class="post-card-media">
        <img src={image.src} alt={image.alt || ''} loading="lazy" decoding="async" />
      </div>
    )}
    <div class="post-card-action">
      <span>阅读全文</span>
      <span aria-hidden="true">-&gt;</span>
    </div>
  </a>
</article>
